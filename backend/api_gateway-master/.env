###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_this_secret_in_production
###< symfony/framework-bundle ###

# URLs base de los microservicios a los que el gateway hace proxy.
# Ajusta estos valores a tu infraestructura real (docker-compose, k8s, etc.)
AUTH_SERVICE_URL=http://localhost:8084
USERS_SERVICE_URL=http://localhost:8081
ORDERS_SERVICE_URL=http://localhost:8082
PRODUCTS_SERVICE_URL=http://localhost:8083

# Timeout (segundos) para las peticiones salientes hacia los microservicios
GATEWAY_HTTP_TIMEOUT=5

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###
