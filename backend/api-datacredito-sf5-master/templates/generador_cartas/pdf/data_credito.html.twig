{% extends 'generador_cartas/pdf/_base.html.twig' %}
{% import 'generador_cartas/pdf/_macros.html.twig' as m %}

{% block contenido %}
    <p class="parrafo">Pereira, {{ m.fechaLarga(date()) }}</p>

    <p class="parrafo destinatario" style="margin-top: 18px;">
        Señor (a)<br>
        <b>{{ cliente.RAZON_SOCIAL }}</b><br>
        <b>NIT: {{ cliente.NUMERO_IDENTIDAD }}</b><br>
        <b>CIUDAD: {{ cliente.CIUDAD }} - {{ cliente.DEPARTAMENTO }}</b><br>
        <small><b>{{ cliente.DIRECCION }}</b></small>
    </p>

    <p class="parrafo" style="margin-top: 10px;">{{ textos.referencia|raw }}</p>

    <p class="parrafo">{{ textos.saludo|raw }}</p>

    <p class="parrafo">{{ textos.intro|raw }}</p>

    <p class="parrafo">{{ textos.parrafoPlazo|raw }}</p>

    <p class="parrafo">{{ textos.parrafoLey1266|raw }}</p>

    <table class="facturas">
        <thead>
            <tr>
                <th>FACTURA</th><th>FECHA</th><th>F VENCE</th><th>V INICIAL</th>
                <th>CARTERA</th><th>DIAS MORA</th><th>INTERES</th><th>TOTAL A PAGAR</th>
            </tr>
        </thead>
        <tbody>
            {% for factura in facturasSelect %}
                {{ m.filaFactura(factura, true) }}
            {% endfor %}
        </tbody>
    </table>

    <p class="parrafo total-letras">Valor total facturas: {{ sumatoriaCarteraTexto }} (${{ sumatoriaCarteraNumber }})</p>

    <p class="parrafo">{{ textos.parrafoCumplimiento|raw }}</p>

    <p class="parrafo">{{ textos.parrafoDinamica|raw }}</p>

    <p class="parrafo">{{ textos.cuentasBancarias|raw }}</p>

    <p class="parrafo">{{ textos.contacto|raw }}</p>

    <p class="parrafo">{{ textos.despedida|raw }}</p>
{% endblock %}
